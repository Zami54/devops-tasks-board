# Laisser VIDE en local, avec Docker Compose et sur Kubernetes :
# le frontend appelle /api, relayé par Vite (dev) ou nginx (conteneur).
# À renseigner UNIQUEMENT sur Render (URL publique de l'API).
VITE_API_URL=

# Cible du proxy /api du serveur de développement Vite (npm run dev).
BACKEND_URL=http://localhost:3000
