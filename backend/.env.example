# Copier en .env pour lancer l'API sans Docker : npm run dev
# Le fichier .env n'est JAMAIS versionné (voir .gitignore).

# Compte applicatif à droits limités (créé par infra/db/app_user.sh)
DATABASE_URL=postgres://app_user:change-me@localhost:5432/tasksdb
DATABASE_SSL=false
PORT=3000

# Origines autorisées à appeler l'API depuis un navigateur (CORS).
# Vide en local : le frontend passe par le proxy /api.
CORS_ORIGIN=
