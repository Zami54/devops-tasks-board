    "test:integration": "node --test test/integration.test.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "oxlint": "^1.90.0",
    "supertest": "^7.3.1"
  }
}
