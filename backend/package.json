{
  "name": "devops-tasks-board-backend",
  "version": "1.0.0",
  "description": "API REST du DevOps Tasks Board (Express + PostgreSQL)",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
