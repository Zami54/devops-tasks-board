# EXEMPLE UNIQUEMENT — ce fichier n'est pas appliqué (extension .example).
#
# Le vrai Secret est créé par ./K8S-start.sh à partir du fichier .env :
#   kubectl create secret generic app-secrets --from-literal=... -n tasks-board
#
# Rappel : un Secret Kubernetes n'est PAS chiffré, il est seulement encodé
# en base64. C'est pour cela qu'il ne doit jamais être versionné dans Git.
apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: tasks-board
type: Opaque
stringData:
  POSTGRES_USER: "devops"
  POSTGRES_PASSWORD: "<mot de passe propriétaire>"
  APP_DB_PASSWORD: "<mot de passe de l'API>"
  DATABASE_URL: "postgres://app_user:<mot de passe de l'API>@postgres-service:5432/tasksdb"
