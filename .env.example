# =============================================================
#  Secrets de l'environnement LOCAL (Docker Compose et Kubernetes)
#
#  1. Copier ce fichier :      cp .env.example .env
#  2. Remplacer chaque « change-me » par un mot de passe aléatoire, par
#     exemple généré avec :    openssl rand -hex 16
#
#  Le fichier .env n'est JAMAIS versionné (.gitignore) : aucun mot de
#  passe n'apparaît dans le dépôt Git.
# =============================================================

POSTGRES_DB=tasksdb

# Compte propriétaire de la base : sert UNIQUEMENT à créer les tables.
POSTGRES_USER=devops
POSTGRES_PASSWORD=change-me

# Compte de l'API : lecture/écriture des tâches, rien de plus.
APP_DB_PASSWORD=change-me-too
